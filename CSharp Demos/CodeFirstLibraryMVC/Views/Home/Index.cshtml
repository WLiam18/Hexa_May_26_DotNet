@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Code First Library</h1>
    <p class="lead">A demo of Entity Framework Core Code First approach</p>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"> Books</h5>
                    <p class="card-text">Manage your book catalog</p>
                    <a href="/Book" class="btn btn-primary">View Books</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="alert alert-info mt-4">
        <strong> Code First Approach</strong>
        <p class="mt-2">
            The database was created automatically from the C# models using EF Core migrations.
        </p>
    </div>
</div>