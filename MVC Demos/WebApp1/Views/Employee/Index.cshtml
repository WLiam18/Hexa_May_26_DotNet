@model List<WebApp1.Models.Employee>

    <h2> Employee List</h2>

    <table border="1" cellpadding="10">
        <thead>
        <tr>
            <th>Employee ID</th>
            <th>Employee Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>City</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeId</td>
                <td>@employee.EmlpoyeeName</td>
                <td>@employee.Department</td>
                <td>@employee.Salary</td>
                <td>@employee.City</td>
            </tr>
        }
    </tbody>

    </table>