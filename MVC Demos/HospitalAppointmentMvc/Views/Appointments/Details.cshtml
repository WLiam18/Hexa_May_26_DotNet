@model HospitalAppointmentMvc.Dtos.AppointmentResponseDto

@{
    ViewData["Title"] = "Appointment Details";
}

<h2>Appointment Details</h2>

<table class="table table-bordered">
    <tr>
        <th>Appointment ID</th>
        <td>@Model.AppointmentId</td>
    </tr>

    <tr>
        <th>Doctor</th>
        <td>@Model.DoctorName</td>
    </tr>

    <tr>
        <th>Patient</th>
        <td>@Model.PatientName</td>
    </tr>

    <tr>
        <th>Date</th>
        <td>@Model.AppointmentDate</td>
    </tr>

    <tr>
        <th>Time</th>
        <td>@Model.AppointmentTime</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.AppointmentStatus</td>
    </tr>

    <tr>
        <th>Reason</th>
        <td>@Model.Reason</td>
    </tr>

    <tr>
        <th>Created At</th>
        <td>@Model.CreatedAt</td>
    </tr>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>